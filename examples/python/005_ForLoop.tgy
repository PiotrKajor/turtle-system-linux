# counting from 0 to 199 in steps of 1 ...
for count in range (200):
    # move forward by count/3 (rounded)
    forward(count/3)
    # turn right by 5 degrees
    right(5)
    # draw red blot radius 200
    colour(red)
    blot(200)
    # draw black circle around the red blot
    colour(black)
    circle(200)
