subdir='testsubdir'
enquire=0
delete=1
create=2
recreate=3
tnotify=4
fnotify=16
tonentry=64
tonexit=128
todo=create

def showresult(b,n):
    if b:
        print(n+' returns True')
    else:
        print(n+' returns False')

output(True,cream,True)
code=todo+tnotify+fnotify
print('The initial CHECKDIR command will invoke a message window')
print('whether or not the directory "testsubdir" exists ...')
print('Code on entry = $'+hex(code,2))
code=checkdir(subdir,code)
print('Code on exit = $'+hex(code,2))
if code&tonentry>0:
    print('Subdirectory existed on entry')
else:
    print('No subdirectory on entry')
if code&tonexit>0:
    print('Subdirectory existed on exit')
else:
    print('No subdirectory on exit')
print('')
showresult(mkdir(subdir),'mkdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
showresult(mkdir(subdir),'mkdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
showresult(rmdir(subdir),'rmdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
showresult(rmdir(subdir),'rmdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
showresult(mkdir(subdir),'mkdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
showresult(mkdir(subdir),'mkdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
if checkfile(subdir+'\\A_File.txt',2)>127:
    print(('File "'+subdir+'\\A_File.txt" has been created').upper())
else:
    print(('File "'+subdir+'\\A_File.txt" could not be created').upper())
showresult(rmdir(subdir),'rmdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
print('')
if checkfile(subdir+'\\A_File.txt',1)<128:
    print(('File "'+subdir+'\\A_File.txt" has been deleted').upper())
else:
    print(('File "'+subdir+'\\A_File.txt" could not be deleted').upper())
showresult(rmdir(subdir),'rmdir('+subdir+')')
showresult(isdir(subdir),'isdir('+subdir+')')
