testfile1='testfile1.txt'
testfile2='testfile2.txt'
enquire=0
delete=1
create=2
recreate=3
tnotify=4
fnotify=16
tonentry=64
tonexit=128
todo=create

def showresult(b,n):
    if b:
        print('  "'+n+'" returns True')
    else:
        print('  "'+n+'" returns False')

output(True,cream,True)
code=todo+tnotify+fnotify
print('Code on entry = $'+hex(code,2))
print('The initial CHECKFILE command will invoke a message window')
print('whether or not the file "testfile1.txt" exists ...')
code=checkfile(testfile1,code)
print('Code on exit = $'+hex(code,2))
if code&tonentry>0:
    print('File existed on entry')
else:
    print('No file on entry')
if code&tonexit>0:
    print('File existed on exit')
else:
    print('No file on exit')
print('')
showresult(isfile(testfile1),'isfile('+testfile1+')')
print('')
showresult(fremove(testfile1),'fremove('+testfile1+')')
showresult(isfile(testfile1),'isfile('+testfile1+')')
print('')
if checkfile(testfile1,2)>127:
    print(('File "'+testfile1+'" has been created').upper())
else:
    print(('File "'+testfile1+'" could not be created').upper())
showresult(isfile(testfile1),'isfile('+testfile1+')')
showresult(isfile(testfile2),'isfile('+testfile2+')')
print('')
if fcopy(testfile1,testfile2):
    print(('File "'+testfile1+'" has been copied to "'+testfile2+'"').upper())
else:
    print(('File "'+testfile1+'" could not be copied to "'+testfile2+'"').upper())
showresult(isfile(testfile1),'isfile('+testfile1+')')
showresult(isfile(testfile2),'isfile('+testfile2+')')
print('')
if checkfile(testfile1,1)<128:
    print(('File "'+testfile1+'" has been deleted').upper())
else:
    print(('File "'+testfile1+'" could not be deleted').upper())
showresult(isfile(testfile1),'isfile('+testfile1+')')
print('')
showresult(fremove(testfile1),'fremove('+testfile1+')')
showresult(isfile(testfile1),'isfile('+testfile1+')')
showresult(isfile(testfile2),'isfile('+testfile2+')')
print('')
if frename(testfile2,testfile1):
    print(('File "'+testfile2+'" has been renamed "'+testfile1+'"').upper())
else:
    print(('File "'+testfile2+'" could not be renamed "'+testfile1+'"').upper())
showresult(isfile(testfile1),'isfile('+testfile1+')')
showresult(isfile(testfile2),'isfile('+testfile2+')')
print('')
showresult(fremove(testfile1),'fremove('+testfile1+')')
showresult(isfile(testfile1),'isfile('+testfile1+')')
