# blue canvas
blank(blue)
# white circle in background
colour(white)
blot(360)
# thick blue line down the middle
setxy(500,0)
colour(blue)
thickness(20)
drawxy(0,1000)
# draw array of blots in 5 random colours
for x in range (111,900,111):
    for y in range (111,900,111):
        setxy(x,y)
        randcol(5)
        blot(25)

# recolour left white area to magenta
pause(2000)
recolour(250,500,magenta)

# fill right in cyan up to blue boundary
pause(2000)
fill(750,500,cyan,blue)
