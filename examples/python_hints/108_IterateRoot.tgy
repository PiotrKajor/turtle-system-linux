output(True,white,False)
n=0
while (n<1) or (n>2147) or (str(intdef(s,0))!=s):
    console(True,cream) # Clear Console, coloured cream
    output(True,cream,False) # Clear Output tab but don't show it yet
    print('CALCULATION OF APPROXIMATE SQUARE ROOTS, BY ITERATION')
    print()
    s=input('Which square root (<2148) would you like to calculate? ')
    n=intdef(s,0)
output(False,cream,True) # Bring Output tab to front without clearing
print()
print()
print('   guess    '+s+'/guess')
square=int(s)*1000000     # shifting decimal point by 6 places
guess=1000                # 1, with decimal point shifted by 3 places
quotient=0
while (guess!=quotient) and (guess!=(guess+quotient)/2):
    quotient=square/guess # quotient, with decimal point shifted by 3 places
    print()
    print(pad(qstr(guess,1000,3),' ',8)+'   '+pad(qstr(quotient,1000,3),' ',8),end ='')
    pause(2000)
    if guess==quotient:
        print()
    else:
        print(pad('  sum = ',' ',14)+pad(qstr(guess+quotient,1000,3),' ',-8),end ='')
        print('  average = '+qstr(guess+quotient,2000,3))
    guess=(guess+quotient)/2
print()
print()
print('The square root of '+s+' is approximately '+qstr(guess,1000,3))
