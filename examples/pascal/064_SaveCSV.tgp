program SaveCSV;
const
  cols=10;
  rows=10;
  a=3;
  b=4;
  fname='SaveCSV.csv';
var
  value:array [1..cols,1..rows] of integer;
  colwidth,rowheight:integer;
  xmargin,ymargin:integer;
  fontsize:integer;
procedure setup; {calculate relevant sizes}
begin
  colwidth:=1000 div (cols+1);
  rowheight:=900 div (rows+1);
  xmargin:=colwidth*3/7;
  ymargin:=rowheight/3;
  fontsize:=colwidth/4
end;
procedure drawgrid; {draw the grid lines}
var
  i,j:integer;
begin
  for i:=0 to cols+1 do
  begin
    if (i=0) or (i=1) or (i=cols+1) then
      thickness(10)
    else
      thickness(2);
    setxy(5+i*colwidth,5);
    drawxy(0,890)
  end;
  for j:=0 to rows+1 do
  begin
    if (j=0) or (j=1) or (j=rows+1) then
      thickness(10)
    else
      thickness(2);
    setxy(5,5+j*rowheight);
    drawxy(995,0)
  end
end;
procedure labelgrid; {add the grid headings}
var
  i,j:integer;
begin
  setxy(colwidth-25,5);
  display('x',0,30);
  setxy(20,rowheight-45);
  display('y',0,30);
  setxy(300,925);
  display('Table of '+str(a)+'x + '+str(b)+'y',0,40);
  for i:=1 to cols do
  begin
    setxy(i*colwidth+xmargin,ymargin);
    display(str(i),0,fontsize)
  end;
  for j:=1 to rows do
  begin
    setxy(xmargin,j*rowheight+ymargin);
    display(str(j),0,fontsize)
  end
end;
procedure calculate; {calculate the array values}
var
  i,j:integer;
begin
  for i:=1 to cols do
    for j:=1 to rows do
      value[i,j]:=a*i+b*j
end;
procedure show; {put array values in grid}
var
  i,j:integer;
begin
  for i:=1 to cols do
    for j:=1 to rows do
  begin
    setxy(i*colwidth+xmargin,j*rowheight+ymargin);
    display(str(value[i,j]),0,fontsize)
  end
end;
procedure savedata; {save values as CSV file}
var
  handle,i,j:integer;
  flag:boolean;
begin
  if fileexists(fname) then
    flag:=deletefile(fname);
  handle:=openfile(fname,3);
  for j:=1 to rows do
  begin
    for i:=1 to cols-1 do
      fwrite(handle,str(value[i,j])+',');
    fwriteln(handle,str(value[cols,j]))
  end;
  closefile(handle)
end;
begin
  setup;
  drawgrid;
  labelgrid;
  calculate;
  show;
  pause(2000);
  savedata;
  writeln('File '+fname+' has been saved')
end.
