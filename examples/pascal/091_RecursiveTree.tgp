program recursivetree;
var
  count:integer;
procedure rdraw(dist,level:integer);
begin
  thickness(level*2);
  forward(dist);
  left(30);
  if level>0 then
    rdraw(3*dist/4,level-1);
  right(30);
  thickness(level*2);
  forward(dist/3);
  right(20);
  if level>0 then
    rdraw(3*dist/4,level-1);
  left(20);
  back(dist/3);
  back(dist)
end;
begin
  blank(black);
  movexy(0,400);
  colour(emerald);
  rdraw(180,10)
end.
